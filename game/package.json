{
  "name": "nexusrpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "check:architecture": "node ../scripts/check_architecture.mjs",
    "assets:manifest": "node ../scripts/build_manifest.mjs",
    "check:manifest": "node ../scripts/build_manifest.mjs --check",
    "check:assets": "node ../scripts/validate_assets.mjs",
    "check:maps": "node ../scripts/map_tool.mjs all --no-render",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check:architecture && npm run test:scripts && npm run check:assets && npm run check:maps && npm test && npm run build && npm run test:e2e",
    "test:scripts": "node --test ../scripts/check_architecture.test.mjs ../scripts/build_manifest.test.mjs",
    "test:walkthrough": "playwright test e2e/walkthrough.pw.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
